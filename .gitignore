# ===== 编译产物（均可由源码重新生成，SquadDeck.bat 会按 mtime 自动重编）=====
out/
*.class
.server-classes/
*.jar

# ===== 第三方大文件（不进仓库，GitHub 单文件上限 100MB）=====
*.exe

# 便携 JDK：把 JDK 解压成 .\jdk 后，run.bat / build.bat 会优先用它，
# 让整个文件夹能拷到没装 JDK 的机器上直接跑。整整 376 MB，不进仓库。
jdk/
jdk*.zip

# ===== 运行日志 / 系统垃圾 =====
*.log
Thumbs.db
desktop.ini

# ===== 编辑器 =====
.vscode/
.idea/

# ===== 本机专属文件（换电脑必然失效，不进仓库）=====
# .lnk 里记的是本机绝对路径（IDList + LocalBasePath），别人克隆后双击无效。
# 需要快捷方式请在本机跑一次 MakeShortcut.ps1 重新生成。
*.lnk

# ===== 其他 =====
node_modules/
.workbuddy/

# ===== 一次性编译产物（AI 对战台等）=====
测试文件/.bench*/
