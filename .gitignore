# ===== 编译产物（均可由源码重新生成，SquadDeck.bat 会按 mtime 自动重编）=====
out/
*.class
.server-classes/
*.jar

# ===== 第三方大文件（不进仓库，GitHub 单文件上限 100MB）=====
*.exe

# ===== 运行日志 / 系统垃圾 =====
*.log
Thumbs.db
desktop.ini

# ===== 编辑器 =====
.vscode/
.idea/

# ===== 本机专属文件（换电脑必然失效，不进仓库）=====
# .lnk 里记的是本机绝对路径（IDList + LocalBasePath），别人克隆后双击无效。
# 需要快捷方式请在本机跑一次 MakeShortcut.ps1 重新生成。
*.lnk

# ===== 其他 =====
node_modules/
.workbuddy/
